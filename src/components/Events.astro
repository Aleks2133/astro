---
import { dateBadge, formatDate, mediaUrl, type EventItem } from '../lib/api';

interface Props {
  events: EventItem[];
}

const { events } = Astro.props;

// Najbliższe wydarzenia na górze; te bez daty na końcu.
const sorted = [...events].sort((a, b) => {
  const ta = new Date(a.event_date).getTime();
  const tb = new Date(b.event_date).getTime();
  if (Number.isNaN(ta)) return 1;
  if (Number.isNaN(tb)) return -1;
  return ta - tb;
});
---

<section id="wydarzenia" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p data-reveal class="text-xs font-medium uppercase tracking-[0.28em] text-matcha-600">Wydarzenia</p>
        <h2
          data-reveal
          style="--reveal-delay: 100ms"
          class="mt-4 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-light leading-tight tracking-[-0.02em] text-matcha-900"
        >
          Co się u nas dzieje
        </h2>
      </div>
      <p data-reveal style="--reveal-delay: 160ms" class="max-w-sm text-clay-800/80">
        Degustacje, warsztaty parzenia i wieczory z muzyką na żywo — wpadnij bez rezerwacji.
      </p>
    </header>

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      {
        sorted.map((event, index) => {
          const image = mediaUrl(event.photo_url);
          const badge = dateBadge(event.event_date);

          return (
            <article
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 90}ms`}
              class="group relative grid overflow-hidden rounded-[2rem] border border-matcha-800/8 bg-cream-50 shadow-sm transition-all duration-500 ease-[var(--ease-soft)] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-matcha-900/10 sm:grid-cols-[minmax(0,14rem)_1fr]"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-matcha-200 sm:aspect-auto sm:h-full">
                {image ? (
                  <img
                    src={image}
                    alt={event.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-soft)] group-hover:scale-[1.07]"
                  />
                ) : (
                  <div class="h-full w-full bg-gradient-to-br from-matcha-300 to-matcha-600" />
                )}

                {badge && (
                  <div class="absolute left-4 top-4 rounded-2xl bg-cream-50/95 px-4 py-2 text-center shadow-lg backdrop-blur">
                    <p class="font-display text-2xl leading-none text-matcha-800">{badge.day}</p>
                    <p class="mt-0.5 text-[11px] uppercase tracking-[0.16em] text-clay-600">{badge.month}</p>
                  </div>
                )}
              </div>

              <div class="flex flex-col justify-center p-7">
                <time
                  datetime={event.event_date}
                  class="text-xs font-medium uppercase tracking-[0.18em] text-matcha-600"
                >
                  {formatDate(event.event_date)}
                </time>
                <h3 class="mt-3 font-display text-2xl leading-snug text-matcha-900">{event.title}</h3>
                {event.description && (
                  <p class="mt-3 text-[15px] leading-relaxed text-clay-800/80">{event.description}</p>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
