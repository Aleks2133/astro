---
import { mediaUrl, type GalleryPhoto } from '../lib/api';

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

const sorted = [...photos].sort((a, b) => a.sort_order - b.sort_order || a.id - b.id);
---

<section id="galeria" class="relative overflow-hidden bg-matcha-900 py-24 text-cream-100 sm:py-32">
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
    <div class="animate-float-slow absolute -left-40 top-10 h-96 w-96 rounded-full bg-matcha-600/40 blur-3xl"></div>
    <div
      class="animate-float-slow absolute -right-32 bottom-0 h-[26rem] w-[26rem] rounded-full bg-gold-500/20 blur-3xl"
      style="animation-delay: -7s"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <header class="max-w-2xl">
      <p data-reveal class="text-xs font-medium uppercase tracking-[0.28em] text-matcha-300">Galeria</p>
      <h2
        data-reveal
        style="--reveal-delay: 100ms"
        class="mt-4 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-light leading-tight tracking-[-0.02em] text-cream-50"
      >
        Wnętrze, światło i para z filiżanki
      </h2>
    </header>

    <div class="mt-14 columns-1 gap-5 sm:columns-2 lg:columns-3 [&>*]:mb-5">
      {
        sorted.map((photo, index) => {
          const src = mediaUrl(photo.photo_url);
          if (!src) return null;

          return (
            <figure
              data-reveal="scale"
              style={`--reveal-delay: ${Math.min(index, 6) * 70}ms`}
              class="group relative break-inside-avoid overflow-hidden rounded-3xl border border-cream-100/10 bg-matcha-800"
            >
              <img
                src={src}
                alt={photo.caption || 'Zdjęcie z kawiarni Pani Matcha'}
                loading="lazy"
                decoding="async"
                class="w-full object-cover transition-transform duration-[1.3s] ease-[var(--ease-soft)] group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-matcha-900/85 via-matcha-900/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
              {photo.caption && (
                <figcaption class="absolute inset-x-0 bottom-0 translate-y-3 p-6 text-sm text-cream-50 opacity-0 transition-all duration-500 ease-[var(--ease-soft)] group-hover:translate-y-0 group-hover:opacity-100">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
