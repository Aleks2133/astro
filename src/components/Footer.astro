---
interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
const year = new Date().getFullYear();
---

<!-- Pasek z powtarzającym się hasłem — subtelny akcent „premium” -->
<div class="overflow-hidden border-y border-matcha-800/10 bg-cream-200 py-5" aria-hidden="true">
  <div class="animate-marquee flex w-max gap-10 whitespace-nowrap">
    {
      Array.from({ length: 2 }).map(() => (
        <span class="flex gap-10">
          {Array.from({ length: 6 }).map(() => (
            <span class="flex items-center gap-10 font-display text-xl font-light tracking-tight text-matcha-700/70">
              Ceremonialna matcha
              <span class="h-1.5 w-1.5 rounded-full bg-gold-400" />
              Kawa speciality
              <span class="h-1.5 w-1.5 rounded-full bg-gold-400" />
              Domowe wypieki
              <span class="h-1.5 w-1.5 rounded-full bg-gold-400" />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<footer class="bg-cream-100 py-14">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-5 sm:px-8 md:flex-row md:justify-between">
    <a href="#top" class="flex items-center gap-3 font-display text-lg text-matcha-900">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-matcha-500 text-cream-50" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 9h13a3 3 0 0 1 0 6h-1" stroke-linecap="round" />
          <path d="M4 9v3a5 5 0 0 0 5 5h3a5 5 0 0 0 5-5V9" stroke-linecap="round" />
        </svg>
      </span>
      Pani Matcha
    </a>

    <nav aria-label="Nawigacja w stopce">
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-sm text-clay-800/75">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-matcha-800">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="text-sm text-clay-600">© {year} Pani Matcha</p>
  </div>
</footer>
