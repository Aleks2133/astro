---
import { externalUrl, type Settings } from '../lib/api';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const instagram = externalUrl(settings.instagram_url);
const phoneHref = settings.contact_phone ? `tel:${settings.contact_phone.replace(/[^\d+]/g, '')}` : null;
---

<section id="kontakt" class="grain relative overflow-hidden bg-matcha-800 py-24 text-cream-100 sm:py-32">
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
    <div class="animate-float-slow absolute -right-24 -top-20 h-96 w-96 rounded-full bg-matcha-500/40 blur-3xl"></div>
    <div
      class="animate-float-slow absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-gold-400/20 blur-3xl"
      style="animation-delay: -5s"
    >
    </div>
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-2 lg:gap-20">
    <div>
      <p data-reveal class="text-xs font-medium uppercase tracking-[0.28em] text-matcha-200">Kontakt</p>
      <h2
        data-reveal
        style="--reveal-delay: 100ms"
        class="mt-4 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-light leading-tight tracking-[-0.02em] text-cream-50"
      >
        Zaparzymy coś dobrego
      </h2>
      <p data-reveal style="--reveal-delay: 180ms" class="mt-6 max-w-md text-lg leading-relaxed text-cream-200/80">
        Zadzwoń, napisz albo po prostu wpadnij. Stolik przy oknie zwykle czeka wolny.
      </p>

      {
        instagram && (
          <a
            data-reveal
            style="--reveal-delay: 260ms"
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-10 inline-flex items-center gap-3 rounded-full bg-cream-50 px-7 py-3.5 font-medium text-matcha-900 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
            </svg>
            Obserwuj na Instagramie
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <dl class="grid gap-4 sm:grid-cols-2">
      {
        settings.opening_hours && (
          <div
            data-reveal
            class="rounded-3xl border border-cream-100/12 bg-cream-50/5 p-7 backdrop-blur transition-colors duration-500 hover:bg-cream-50/10 sm:col-span-2"
          >
            <dt class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-matcha-200">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" stroke-linecap="round" />
              </svg>
              Godziny otwarcia
            </dt>
            <dd class="mt-3 font-display text-2xl text-cream-50">{settings.opening_hours}</dd>
          </div>
        )
      }

      {
        settings.contact_phone && (
          <div
            data-reveal
            style="--reveal-delay: 90ms"
            class="rounded-3xl border border-cream-100/12 bg-cream-50/5 p-7 backdrop-blur transition-colors duration-500 hover:bg-cream-50/10"
          >
            <dt class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-matcha-200">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                <path
                  d="M5 4h3l2 5-2.5 1.5a12 12 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.2 2 2 0 0 1 5 4z"
                  stroke-linejoin="round"
                />
              </svg>
              Telefon
            </dt>
            <dd class="mt-3">
              <a href={phoneHref!} class="font-display text-2xl text-cream-50 underline-offset-4 hover:underline">
                {settings.contact_phone}
              </a>
            </dd>
          </div>
        )
      }

      {
        settings.contact_email && (
          <div
            data-reveal
            style="--reveal-delay: 160ms"
            class="rounded-3xl border border-cream-100/12 bg-cream-50/5 p-7 backdrop-blur transition-colors duration-500 hover:bg-cream-50/10 sm:col-span-2"
          >
            <dt class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-matcha-200">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="m4 7 8 6 8-6" stroke-linecap="round" />
              </svg>
              E-mail
            </dt>
            <dd class="mt-3">
              <a
                href={`mailto:${settings.contact_email}`}
                class="font-display text-xl text-cream-50 underline-offset-4 hover:underline [overflow-wrap:anywhere]"
              >
                {settings.contact_email}
              </a>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</section>
