---
import { mediaUrl, type Product } from '../lib/api';

interface Props {
  heroText: string;
  openingHours?: string;
  /** Pierwsze zdjęcie produktu jako wizual hero — jeśli panel jakieś ma. */
  featured?: Product | null;
}

const { heroText, openingHours, featured } = Astro.props;
const featuredImage = mediaUrl(featured?.photo_url);

const headline = heroText?.trim() || 'Matcha, która smakuje jak spokojny poranek';
---

<section id="top" class="grain relative isolate overflow-hidden pt-28 pb-20 sm:pt-36 lg:pt-44 lg:pb-32">
  <!-- Tło: miękkie plamy koloru + siatka -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-b from-matcha-100 via-cream-100 to-cream-100"></div>
    <div
      class="animate-float-slow absolute -left-24 -top-24 h-[28rem] w-[28rem] rounded-full bg-matcha-300/45 blur-3xl"
    >
    </div>
    <div
      class="animate-float-slow absolute -right-32 top-24 h-[32rem] w-[32rem] rounded-full bg-gold-400/20 blur-3xl"
      style="animation-delay: -6s"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
    <div>
      <p
        data-reveal
        class="inline-flex items-center gap-2 rounded-full border border-matcha-800/12 bg-cream-50/70 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.22em] text-matcha-700 backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-matcha-500"></span>
        Kawiarnia &amp; matcha bar
      </p>

      <h1
        data-reveal
        style="--reveal-delay: 120ms"
        class="mt-7 font-display text-[clamp(2.6rem,7vw,4.9rem)] font-light leading-[1.03] tracking-[-0.02em] text-matcha-900"
      >
        <span class="text-shimmer">{headline}</span>
      </h1>

      <p
        data-reveal
        style="--reveal-delay: 240ms"
        class="mt-7 max-w-xl text-lg leading-relaxed text-clay-800/85 sm:text-xl"
      >
        Ceremonialna matcha, kawa speciality i wypieki prosto z pieca. Miejsce, w którym
        każdy detal — od ubijania pianki po światło na stole — został przemyślany.
      </p>

      <div data-reveal style="--reveal-delay: 340ms" class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#menu"
          class="group relative overflow-hidden rounded-full bg-matcha-800 px-8 py-4 text-base font-medium text-cream-50 shadow-xl shadow-matcha-800/25 transition-all duration-500 ease-[var(--ease-soft)] hover:-translate-y-1 hover:shadow-2xl"
        >
          <span class="relative z-10">Zobacz menu</span>
          <span
            class="absolute inset-0 -translate-x-full bg-matcha-600 transition-transform duration-500 ease-[var(--ease-soft)] group-hover:translate-x-0"
          ></span>
        </a>
        <a
          href="#kontakt"
          class="rounded-full border border-matcha-800/20 px-8 py-4 text-base font-medium text-matcha-900 transition-all duration-300 hover:-translate-y-1 hover:border-matcha-800/40 hover:bg-cream-50"
        >
          Odwiedź nas
        </a>
      </div>

      {
        openingHours && (
          <p data-reveal style="--reveal-delay: 440ms" class="mt-9 flex items-center gap-3 text-sm text-clay-600">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-matcha-500 opacity-60" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-matcha-500" />
            </span>
            Otwarte dziś&nbsp;<strong class="font-semibold text-matcha-800">{openingHours}</strong>
          </p>
        )
      }
    </div>

    <!-- Wizual -->
    <div data-reveal="scale" style="--reveal-delay: 200ms" class="relative">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-md">
        <div
          class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-matcha-200/70 to-gold-400/25 blur-2xl"
          aria-hidden="true"
        >
        </div>

        <div
          class="relative h-full w-full overflow-hidden rounded-[2rem] border border-cream-50/60 bg-matcha-200 shadow-2xl shadow-matcha-900/25"
        >
          {
            featuredImage ? (
              <img
                src={featuredImage}
                alt={featured?.name ?? 'Matcha latte w Pani Matcha'}
                width="800"
                height="1000"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-soft)] hover:scale-105"
              />
            ) : (
              <div class="grid h-full w-full place-items-center bg-gradient-to-br from-matcha-300 to-matcha-600">
                <svg viewBox="0 0 120 120" class="h-32 w-32 text-cream-100/90" fill="none" stroke="currentColor" stroke-width="3">
                  <path d="M24 48h64a14 14 0 0 1 0 28h-6" stroke-linecap="round" />
                  <path d="M24 48v14a26 26 0 0 0 26 26h12a26 26 0 0 0 26-26V48" stroke-linecap="round" />
                </svg>
              </div>
            )
          }

          <!-- Pasemka „pary” nad kubkiem -->
          <div class="pointer-events-none absolute inset-x-0 top-6 flex justify-center gap-3" aria-hidden="true">
            <span class="animate-steam h-10 w-[3px] rounded-full bg-cream-50/60 blur-[2px]"></span>
            <span class="animate-steam h-14 w-[3px] rounded-full bg-cream-50/50 blur-[2px]" style="animation-delay: 1s"></span>
            <span class="animate-steam h-10 w-[3px] rounded-full bg-cream-50/60 blur-[2px]" style="animation-delay: 2s"></span>
          </div>
        </div>

        <!-- Pływająca plakietka -->
        <div
          class="animate-float-slow absolute -bottom-6 -left-6 rounded-2xl border border-matcha-800/10 bg-cream-50/95 px-5 py-4 shadow-xl shadow-matcha-900/10 backdrop-blur sm:-left-10"
        >
          <p class="font-display text-2xl leading-none text-matcha-800">100%</p>
          <p class="mt-1 text-xs uppercase tracking-[0.18em] text-clay-600">matcha z Uji</p>
        </div>
      </div>
    </div>
  </div>
</section>
