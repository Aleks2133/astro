---
import { formatPrice, mediaUrl, type Category, type Product } from '../lib/api';

interface Props {
  groups: { category: Category; products: Product[] }[];
}

const { groups } = Astro.props;
---

<section id="menu" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <p data-reveal class="text-xs font-medium uppercase tracking-[0.28em] text-matcha-600">Karta</p>
      <h2
        data-reveal
        style="--reveal-delay: 100ms"
        class="mt-4 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-light leading-tight tracking-[-0.02em] text-matcha-900"
      >
        Menu, które warto smakować powoli
      </h2>
      <p data-reveal style="--reveal-delay: 180ms" class="mt-5 text-lg text-clay-800/80">
        Wszystko przygotowujemy na miejscu, ze składników od lokalnych dostawców.
      </p>
    </header>

    {
      groups.length === 0 && (
        <p class="mt-16 text-center text-clay-600">Menu jest właśnie aktualizowane — zajrzyj wkrótce.</p>
      )
    }

    <div class="mt-16 space-y-20">
      {
        groups.map((group, groupIndex) => (
          <div>
            <div data-reveal class="flex items-end gap-5">
              <h3 class="font-display text-2xl font-normal capitalize tracking-tight text-matcha-800 sm:text-3xl">
                {group.category.name}
              </h3>
              <span class="mb-2 h-px flex-1 bg-gradient-to-r from-matcha-800/25 to-transparent" />
              <span class="mb-1.5 text-xs uppercase tracking-[0.18em] text-clay-600">
                {group.products.length}{' '}
                {group.products.length === 1 ? 'pozycja' : 'pozycji'}
              </span>
            </div>

            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {group.products.map((product, index) => {
                const image = mediaUrl(product.photo_url);
                const unavailable = Number(product.is_available) === 0;

                return (
                  <li
                    data-reveal="scale"
                    style={`--reveal-delay: ${Math.min(index, 5) * 80}ms`}
                    class:list={[
                      'group relative flex flex-col overflow-hidden rounded-3xl border border-matcha-800/8 bg-cream-50 shadow-sm transition-all duration-500 ease-[var(--ease-soft)] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-matcha-900/10',
                      unavailable && 'opacity-70',
                    ]}
                  >
                    {image && (
                      <div class="relative aspect-[4/3] overflow-hidden bg-matcha-100">
                        <img
                          src={image}
                          alt={product.name}
                          width="600"
                          height="450"
                          loading={groupIndex === 0 && index < 3 ? 'eager' : 'lazy'}
                          decoding="async"
                          class="h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-soft)] group-hover:scale-[1.07]"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-matcha-900/25 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
                      </div>
                    )}

                    <div class="flex flex-1 flex-col p-6">
                      <div class="flex items-start justify-between gap-4">
                        <h4 class="font-display text-xl leading-snug text-matcha-900">{product.name}</h4>
                        <p class="shrink-0 rounded-full bg-matcha-100 px-3 py-1 text-sm font-semibold text-matcha-800">
                          {formatPrice(product.price)}
                        </p>
                      </div>

                      {product.description && (
                        <p class="mt-3 text-[15px] leading-relaxed text-clay-800/80">{product.description}</p>
                      )}

                      {unavailable && (
                        <p class="mt-4 inline-flex w-fit items-center gap-2 rounded-full bg-clay-400/25 px-3 py-1 text-xs font-medium uppercase tracking-wider text-clay-800">
                          Chwilowo niedostępne
                        </p>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
