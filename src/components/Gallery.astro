---
import { mediaUrl, type GalleryPhoto } from '../lib/api';

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

const sorted = [...photos].sort((a, b) => a.sort_order - b.sort_order || a.id - b.id);
const tilts = ['tilt-left', 'tilt-right', ''];
---

<section id="galeria" class="relative overflow-hidden bg-matcha-900 py-24 text-cream-100 sm:py-32">
  <div class="dot-grid pointer-events-none absolute inset-0 text-cream-50/[0.04]" aria-hidden="true"></div>
  <div class="blob-1 animate-float-slow pointer-events-none absolute -left-40 top-0 h-[30rem] w-[30rem] bg-matcha-600/30" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p data-reveal class="text-xs font-medium uppercase tracking-[0.28em] text-matcha-300">Galeria</p>
        <h2
          data-reveal
          style="--reveal-delay: 100ms"
          class="mt-4 font-display text-[clamp(2.1rem,4.6vw,3.4rem)] font-light leading-tight tracking-[-0.02em] text-cream-50"
        >
          Wnętrze, światło i para z filiżanki
        </h2>
      </div>
      <p data-reveal style="--reveal-delay: 160ms" class="font-hand text-2xl text-matcha-200">
        kilka kadrów z naszej kuchni →
      </p>
    </header>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((photo, index) => {
          const src = mediaUrl(photo.photo_url);
          const tilt = tilts[index % tilts.length];

          return (
            <figure
              data-reveal="scale"
              style={`--reveal-delay: ${Math.min(index, 6) * 80}ms`}
              class={`group relative aspect-[4/5] overflow-hidden rounded-2xl border border-cream-100/10 shadow-xl shadow-matcha-950/30 transition-transform duration-500 ease-[var(--ease-soft)] hover:rotate-0 hover:scale-[1.03] ${tilt}`}
            >
              {src ? (
                <>
                  <img
                    src={src}
                    alt={photo.caption || 'Zdjęcie z kawiarni Pani Matcha'}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-matcha-950/85 via-matcha-950/5 to-transparent" />
                  {photo.caption && (
                    <figcaption class="absolute inset-x-0 bottom-0 p-5 text-sm text-cream-50">
                      {photo.caption}
                    </figcaption>
                  )}
                </>
              ) : (
                <div class="dot-grid relative flex h-full w-full flex-col items-center justify-center gap-3 bg-matcha-800 text-cream-50/40">
                  <svg viewBox="0 0 48 48" class="h-10 w-10 opacity-70" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="5" y="10" width="38" height="28" rx="3" />
                    <circle cx="17" cy="20" r="3.5" />
                    <path d="m8 33 10-9 8 7 6-6 8 8" stroke-linejoin="round" stroke-linecap="round" />
                  </svg>
                  {photo.caption && (
                    <p class="px-4 text-center font-hand text-xl text-cream-50/70">{photo.caption}</p>
                  )}
                  <span class="text-[10px] uppercase tracking-[0.18em] text-cream-50/30">zdjęcie w drodze</span>
                </div>
              )}
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
